<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>DotFlyer.Common</PackageId>
    <Version>1.4.4</Version>
    <AssemblyVersion>1.4.4</AssemblyVersion>
    <Company>Uniphar Group Plc.</Company>
    <Description>Library that contains payloads for DotFlyer Service.</Description>
    <RepositoryUrl>https://github.com/Uniphar/dotflyer/tree/main/src/DotFlyer.Common</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Nullable>enable</Nullable>
  </PropertyGroup>



  <ItemGroup>
    <None Include="LICENSE" Pack="True" PackagePath="\" />
    <None Include="README.md" Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>
