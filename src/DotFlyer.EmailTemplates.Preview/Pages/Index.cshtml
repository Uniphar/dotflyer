@page
@using DotFlyer.EmailTemplates.Preview
@inject TemplateCatalog Catalog
@{
    var templates = Catalog.Templates;
    var firstSrc = templates.Count > 0 ? $"/preview/{Uri.EscapeDataString(templates[0].Name)}" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Email template preview</title>
<style>
:root { color-scheme: light; --ink: #1d1f23; --muted: #5d636e; --line: #dde0e5; --bg: #eef0f3; --accent: #2f5bd3; accent-color: var(--accent); }
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body { display: flex; flex-direction: column; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; }
::selection { background: #cfdcfb; }
header { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 10px 16px; background: #fff; border-bottom: 1px solid var(--line); }
h1 { margin: 0 auto 0 0; font-size: 14px; font-weight: 600; }
label { color: var(--muted); }
select { font: inherit; color: inherit; padding: 5px 8px; min-width: 14rem; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
select:hover { border-color: #b9bec7; }
a { color: var(--accent); text-underline-offset: 3px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
main { flex: 1; display: flex; padding: 16px; min-height: 0; }
iframe { flex: 1; width: 100%; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
.empty { margin: auto; color: var(--muted); }
</style>
</head>
<body>
<header>
<h1>Email template preview</h1>
@if (templates.Count > 0)
{
    <label for="template">Template</label>
    <select id="template" onchange="var s='/preview/'+encodeURIComponent(this.value);document.getElementById('preview').src=s;document.getElementById('open').href=s">
        @foreach (var template in templates)
        {
            <option value="@template.Name">@template.Name</option>
        }
    </select>
    <a id="open" href="@firstSrc" target="_blank" rel="noopener">Open in new tab</a>
}
</header>
<main>
@if (templates.Count > 0)
{
    <iframe id="preview" title="Email preview" src="@firstSrc"></iframe>
}
else
{
    <p class="empty">No templates registered.</p>
}
</main>
</body>
</html>
