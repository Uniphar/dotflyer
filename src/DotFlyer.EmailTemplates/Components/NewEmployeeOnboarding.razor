@namespace DotFlyer.EmailTemplates.Components
@using DotFlyer.Common.EmailTemplates
@inherits Microsoft.AspNetCore.Components.ComponentBase

@code {
    [Parameter]
    public required NewEmployeeOnboardingModel Model { get; set; }
}

<BaseEmailLayout Environment="@Model.Environment">
    <div class="subject">Your Microsoft 365 Work Account Is Ready</div>

    <p>Hi @Model.FirstName,</p>
    <p>Welcome to Uniphar. Your Microsoft 365 work account has been set up. Use the details below to sign in for the first time.</p>

    <div class="info-card">
        <p class="info-card-title">Your Sign-in Details</p>

        <p><strong>Microsoft 365 username:</strong> @Model.UserPrincipalName</p>

        @if (!string.IsNullOrEmpty(Model.PwPushUrl))
        {
            <div class="mt-4">
                <p>
                    <strong>Password delivery link:</strong>
                    <a href="@Model.PwPushUrl">@Model.PwPushUrl</a><br />
                    <span class="email-muted">
                        Link valid for @Model.PwPushExpiresInHours hours or @Model.PwPushExpiresAfterViews views (whichever comes first).
                    </span>
                </p>
            </div>
        }
    </div>

    <div class="mt-4">
        <p class="email-muted"><strong>Important:</strong> Your password is not included in this email. Please do not forward this email or share your sign-in details with anyone. If you were not expecting this email, do not open any links in it.</p>
    </div>
</BaseEmailLayout>
